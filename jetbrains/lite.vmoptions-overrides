# Applied on top of the IDE's own bin/<ide>64.vmoptions to build a Lite profile's vmoptions.
# "-Xkey" / "-XX:Key=" / "-Dkey=" lines replace the same option; "!<prefix>" removes lines starting with <prefix>.
#
# Heap: 1 GB. After a forced GC the live data of a 3-project Rust workspace was ~530 MB; the rest of a
# 1.5 GB heap was garbage G1 was in no hurry to collect. If the IDE warns about low memory or stalls,
# go back to -Xmx1536m (large Kotlin projects and several Cargo workspaces at once need it).
-Xms128m
-Xmx1024m
# When idle, collect every 30 s and hand freed memory back to the OS.
-XX:G1PeriodicGCInterval=30000
# Give memory back sooner: by default G1 only shrinks the heap when more than 70 % of it is free, so a
# heap that was 60 % free kept ~600 MB for nothing. With 10/30 it grows only as needed and shrinks
# back. (Measured with jcmd on a live IDE: -160 MB at once; -530 MB with the three lines below.)
-XX:MinHeapFreeRatio=10
-XX:MaxHeapFreeRatio=30
# A soft ceiling: G1 tries to keep the heap under 640 MB but may still grow to -Xmx under pressure,
# so this can't cause OutOfMemoryError.
-XX:SoftMaxHeapSize=640m
# The IDE's "File cache" (memory-mapped index pages) may grow to 600 MB by default
# (intellij-community: PageCacheUtils.java); 100 MB is plenty for one project.
-Dfile-page-cache.cache-capacity-mb=100
# Once a minute, return memory glibc malloc keeps in reserve. Small, but free.
-XX:TrimNativeHeapInterval=60000
# Fewer GC worker threads (default up to 10 on 12 CPUs) — less native memory, slightly longer pauses.
-XX:ParallelGCThreads=4
-XX:ConcGCThreads=1
# Half the JIT code cache, and soft references (caches) are let go sooner.
-XX:ReservedCodeCacheSize=256m
-XX:SoftRefLRUPolicyMSPerMB=50
# No embedded Chromium (JCEF): ~9 processes / ~0.5 GB. Markdown preview loses some features and
# browser-based tool windows go blank.
-Dide.browser.jcef.enabled=false
# Identical strings stored once in the heap; a little CPU for a few % of heap.
-XX:+UseStringDeduplication
# C1-only JIT: less memory for compiled code, but indexing and inspections get slower. First thing to
# remove if the IDE feels sluggish.
-XX:TieredStopAtLevel=1
# No Git log index: it held ~380k commit objects in the heap. Searching history in the Git tool window
# gets slower.
-Dvcs.log.index.enable=false
# No AI promotion pop-ups, no AI licence flag.
-Dllm.show.ai.promotion.window.on.start=false
!-Denable.non.commercial.ai.license
